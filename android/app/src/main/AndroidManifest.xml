<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required from Android 13 (API 33) onwards, and NOT declared by @capacitor/push-notifications
         itself — checked rather than assumed. Without it the runtime permission request silently
         resolves to "denied" without ever showing the user a dialog, so notifications appear to be
         refused by a person who was never asked. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declared explicitly rather than inherited from @capacitor/haptics' own manifest, because
         SiqtHapticsPlugin is ours and now depends on it directly; removing that plugin some day
         should not silently take the app's haptics with it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
