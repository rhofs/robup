{
  "name": "siqt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,collab -c blue,magenta \"npm:dev:next\" \"npm:dev:collab\"",
    "dev:next": "next dev",
    "dev:collab": "tsx watch --env-file=.env.local server/collabServer.ts",
    "collab:start": "tsx --env-file=.env.local server/collabServer.ts",
    "build": "next build",
    "start": "next start",
    "collab:start:prod": "tsx server/collabServer.ts",
    "start:prod": "concurrently -n next,collab -c blue,magenta \"npm:start\" \"npm:collab:start:prod\"",
    "deploy:prod": "npx prisma db push && npm run start:prod",
    "lint": "next lint",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "backfill:dm-keys": "tsx --env-file=.env.local scripts/backfillDmKeys.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hocuspocus/provider": "^4.5.0",
    "@hocuspocus/server": "^4.5.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-bold": "^3.29.2",
    "@tiptap/extension-bullet-list": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-collaboration-caret": "^3.29.2",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-hard-break": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-italic": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list-item": "^3.29.2",
    "@tiptap/extension-ordered-list": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-strike": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@tiptap/y-tiptap": "^3.0.8",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "framer-motion": "^12.42.2",
    "googleapis": "^174.0.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.19.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
