datasource db {
  provider = "sqlite"
  // Was hardcoded to "file:./dev.db" regardless of environment — fine while this only ever ran
  // locally, but meant the production database would end up literally named "dev.db" too, with
  // no way to point it somewhere else (e.g. a persistent volume) without editing this file.
  // DATABASE_URL is set in .env.local for local dev (still "file:./dev.db", zero change in
  // practice) and should be set to something like "file:./siqt.db" (or a persistent-volume path)
  // in production.
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Øverste beholder
model Workspace {
  id              String   @id @default(uuid())
  name            String
  messageOfTheDay String?  @map("message_of_the_day")
  spaces          Space[]
  rooms           Room[]
  events          Event[]
  chatChannels    ChatChannel[]
  // Explicit join model, not a plain implicit M2M like Task.assignees/User.tasks below — this one
  // needs to carry a role tier (owner/admin/member) per membership row, which an implicit M2M
  // can't do. A workspace with exactly one member is still what "private" means in this app:
  // nobody else is ever a member, so nothing scoped under it is ever returned to anyone else's
  // GET /api/tasks etc.
  memberships     WorkspaceMembership[]
  roles           Role[]
  invites         WorkspaceInvite[]
  // The one auto-created single-member workspace behind the sidebar's private "My tasks" list —
  // distinguishes it from any other single-member workspace a user creates by hand via the
  // normal switcher (which should still show up there; this one deliberately doesn't).
  isPersonal      Boolean  @default(false) @map("is_personal")
  // Unique per user — makes find-or-create atomic via a single upsert (POST
  // /api/workspaces/personal) instead of a separate findFirst-then-create, which raced under
  // React Strict Mode's dev-mode double-invoke (two near-simultaneous requests both saw "no
  // existing personal workspace" and both created one). Null for every non-personal workspace.
  personalOwnerId String?  @unique @map("personal_owner_id")
  createdAt       DateTime @default(now()) @map("created_at")
}

// Workspace membership + role tier (owner/admin/member) — governs who can manage the workspace
// itself: create/delete Roles, mark Spaces/Folders/Lists/Tasks private, manage other members'
// Admin status. Exactly one 'owner' row per workspace (the creator; enforced at the application
// layer, not the schema — SQLite/Prisma has no partial-unique-index support to express "at most
// one row per workspaceId where role='owner'"). Distinct from Role below: this tier is a fixed,
// three-value governance concept, not an arbitrary user-created access-grouping tag.
model WorkspaceMembership {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // 'owner' | 'admin' | 'member'
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, userId])
}

// Arbitrary, workspace-scoped, user-named groups (Discord-style) — used purely for granting
// access to private Spaces/Folders/Lists/Tasks (see their accessJson below), not permission bits.
// A user's Role membership only matters within that Role's own workspace.
model Role {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String    @default("#6366F1")
  members     User[]    @relation("RoleMembers")
  createdAt   DateTime  @default(now()) @map("created_at")
}

// Shareable, Discord-style invite link (the `id` itself is the code in /invite/[id]) — reusable
// and unlimited by default (no expiry/max-uses in this pass, matching Discord's own default
// invite behavior; not asked for, a deliberate scope cut rather than a silent gap). "Revoking" an
// invite is just deleting this row — GET/accept both treat a missing row as an invalid link, so
// no separate `revoked` flag is needed. Never carries role: 'owner' — that tier is fixed at
// workspace creation with no transfer mechanism.
model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("member") // 'admin' | 'member'
  createdById String    @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
}

// Explicit user-to-user connection — the thing that lets two people who share NO Workspace start
// a DM. Coworkers do NOT get a row here: sharing any Workspace via WorkspaceMembership already
// counts as "connected" for DM/group purposes (see lib/auth/connections.ts's
// getConnectedUserIds/areConnected), computed on the fly rather than materialized — this table is
// only ever written when someone accepts a /connect/[code] link from outside any shared
// Workspace. One row per pair, stored in canonical order (userAId < userBId, enforced at the
// application layer via lib/auth/connections.ts's canonicalPair()) so a pair is representable by
// exactly one row and a lookup never needs an OR-query across both column orders.
model Connection {
  id        String   @id @default(uuid())
  userAId   String   @map("user_a_id")
  userA     User     @relation("ConnectionsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String   @map("user_b_id")
  userB     User     @relation("ConnectionsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userAId, userBId])
}

// Pending connection request — opening someone's /connect/[code] link creates one of these (from
// the visitor to the link owner) rather than an instant Connection; the link owner then sees it as
// an incoming request in the Connections tab and explicitly accepts or declines it (see
// app/api/connect/[code]/accept/route.ts and app/api/connections/requests/*). Directional, unlike
// Connection's own canonical-pair storage, since "who requested whom" is exactly what the
// incoming/outgoing split in the UI needs to show. Accepting creates the real Connection row
// (canonical pair) and deletes this row; declining just deletes it. If both people happen to
// request each other (B opens A's link, A separately opens B's), the second request's own route
// detects the reverse row already exists and auto-accepts both immediately — mirrors real
// friend-request UX (mutual add = instant friends, no redundant double-confirm).
model ConnectionRequest {
  id          String   @id @default(uuid())
  fromUserId  String   @map("from_user_id")
  fromUser    User     @relation("ConnectionRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String   @map("to_user_id")
  toUser      User     @relation("ConnectionRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([fromUserId, toUserId])
}

// Personal, reusable connect-link — mirrors WorkspaceInvite's shape (`id` itself is the code in
// /connect/[id], reusable/unlimited, no expiry, "revoke" = delete the row) minus `role` (a
// connection has no tiers) and `workspaceId` (this belongs to a User, not a Workspace).
// createdById is @unique — each user has exactly ONE personal link at a time, not a manageable
// list, making GET /api/connections/invite's find-or-create atomic via upsert (same
// Workspace.personalOwnerId precedent this schema already uses to dodge a Strict-Mode
// double-invoke race). Opening this link while signed in creates a ConnectionRequest (see above)
// rather than an instant Connection — the link owner must explicitly accept it, same "real accept
// step" shape as WorkspaceInvite's own /invite/[code] page, just requiring the *owner's* action
// instead of the visitor's.
model ConnectionInvite {
  id          String   @id @default(uuid())
  createdById String   @unique @map("created_by_id")
  createdBy   User     @relation("ConnectionInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
}

// Kosé "kontorer" i Office-fanen — rent visuelt/organisatorisk, ingen kobling til Space-treet.
// Sletting av et rom fjerner ikke medlemmene, de blir bare urepresenterte (SetNull).
model Room {
  id          String    @id @default(uuid())
  name        String
  icon        String?
  color       String?
  // Independent from `color` above — colors the name text specifically. Room has no real "icon"
  // (a plain emoji), so `color` today only tints the floor's border; this is the closest honest
  // equivalent to icon/text independence for this model. Null falls back to `color`.
  textColor   String?   @map("text_color")
  order       Int       @default(0)
  isDnd       Boolean   @default(false) @map("is_dnd")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     User[]
  createdAt   DateTime  @default(now()) @map("created_at")
}

// 2. Avdelinger
model Space {
  id            String        @id @default(uuid())
  name          String
  color         String        @default("#3B82F6")
  // Independent from `color` above — colors the sidebar name text specifically; the icon/dot
  // keeps using `color` alone. Null falls back to `color`.
  textColor     String?       @map("text_color")
  // Same nullable lucide-icon-name shape as Folder.icon/List.icon below (FOLDER_ICON_MAP in
  // components/FolderTree.tsx maps the string to a component) — null means "no icon chosen yet,"
  // rendered as today's plain color dot instead. Personalizing a Space before this was just typing
  // an emoji into its name; this is the real, dedicated field.
  icon          String?
  order         Int           @default(0)
  description   String?
  coverImageUrl String?       @map("cover_image_url")
  deletedAt     DateTime?     @map("deleted_at")
  workspaceId   String        @map("workspace_id")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folders       Folder[]
  lists         List[]
  statuses      Status[]
  customFields  CustomField[]
  docFolders    DocFolder[]
  docs          Doc[]
  // A Planner Event optionally links here for color-coding only — never required, unlike List/Doc
  // which genuinely live inside a Space. Deleting a Space un-links its Events (SetNull on the
  // Event side) rather than deleting them.
  events        Event[]
  chatChannels  ChatChannel[]
  // Independent per-level private access (Space/Folder/List/Task each have this same pair) — a
  // private item is visible only to the workspace's Owner/Admins plus whoever accessJson grants.
  // Defaults keep every existing row (and every new one until someone opts in) fully open, same
  // as today — purely additive. JSON array of { type: 'user' | 'role', id: string }, same
  // "small flexible list as a JSON string" shape as CustomField.options below — a stale
  // user/role id left behind after a deletion is harmless here for the same reason @mentions
  // already tolerate dangling targets (falls back to "not visible to anyone but Owner/Admin,"
  // never a crash).
  isPrivate     Boolean       @default(false) @map("is_private")
  accessJson    String        @default("[]") @map("access_json")
  createdAt     DateTime      @default(now()) @map("created_at")
}

// 3. Valgfritt mellomnivå (Mappe) — kan nøstes vilkårlig dypt i seg selv
model Folder {
  id         String    @id @default(uuid())
  name       String
  color      String?
  // Independent from `color` above — colors the sidebar name text specifically; the icon keeps
  // using `color` alone. Null falls back to `color`.
  textColor  String?   @map("text_color")
  icon       String?
  deletedAt  DateTime? @map("deleted_at")
  spaceId    String    @map("space_id")
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId   String?   @map("parent_id")
  parent     Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]  @relation("FolderChildren")
  lists      List[]
  docs       Doc[]
  order      Int       @default(0)
  // See Space.isPrivate/accessJson above — same shape, independent at this level.
  isPrivate  Boolean   @default(false) @map("is_private")
  accessJson String    @default("[]") @map("access_json")
  createdAt  DateTime  @default(now()) @map("created_at")
}

// 4. Endestasjon for oppgaver (Lister)
model List {
  id           String        @id @default(uuid())
  name         String
  color        String?
  // Independent from `color` above — colors the sidebar name text specifically; the icon/dot
  // keeps using `color` alone. Null falls back to `color`, so nothing changes for existing rows.
  textColor    String?       @map("text_color")
  icon         String?
  deletedAt    DateTime?     @map("deleted_at")
  // Non-destructive "get this out of the way without deleting it" — independent of deletedAt
  // (Trash). Cascades to every Task/subtask inside on archive/restore (lib/archiveCascade.ts).
  archived     Boolean       @default(false)
  spaceId      String        @map("space_id")
  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folderId     String?       @map("folder_id")
  folder       Folder?       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  order        Int           @default(0)
  tasks        Task[]
  customFields CustomField[]
  // See Space.isPrivate/accessJson above — same shape, independent at this level.
  isPrivate    Boolean       @default(false) @map("is_private")
  accessJson   String        @default("[]") @map("access_json")
  createdAt    DateTime      @default(now()) @map("created_at")
}

// 5. Egendefinerte statuser per Space
model Status {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#94A3B8")
  order     Int      @default(0)
  spaceId   String   @map("space_id")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
}

// 6. Egendefinerte felt/kolonner per Space
model CustomField {
  id        String   @id @default(uuid())
  name      String
  type      String
  options   String   @default("[]")
  spaceId   String   @map("space_id")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // Null = Space-wide (every existing field, and any created with no single List selected).
  // Set = only that List's own task table shows this column — a field created while exactly one
  // List is active from now on. Deliberately not a backfill/migration of existing rows.
  listId    String?  @map("list_id")
  list      List?    @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
}

// 7. Brukere som kan tildeles oppgaver / skrive kommentarer
model User {
  id            String    @id @default(uuid())
  name          String
  // Defaulted (was bare-required) — @auth/prisma-adapter's createUser() only ever supplies
  // id/name/email/emailVerified/image, so a brand-new Google sign-in's very first insert would
  // otherwise violate NOT NULL before anything else runs. Backfilled to a real value right after,
  // in auth.ts's events.createUser hook.
  initials      String    @default("")
  color         String    @default("#6366F1")
  calendarToken String    @unique @default(uuid()) @map("calendar_token")
  phone         String?
  title         String?
  status        String?
  isDnd         Boolean   @default(false) @map("is_dnd")

  // Real accounts (Google OAuth + email/password login). Nullable+unique mirrors the existing
  // Workspace.personalOwnerId precedent — SQLite treats NULL as distinct under a unique index, so
  // every seeded/demo User keeps email: null with zero collisions, while every real signup gets a
  // genuinely unique one. Seed users are permanently unreachable via real login (no email, no
  // password, no linked Account) — real accounts start completely fresh, seed data stays only as
  // local dev/demo fixture data.
  email         String?   @unique
  // Required by @auth/prisma-adapter's AdapterUser contract (written on OAuth sign-in). No
  // magic-link/verification-email flow exists — Google's asserted email is trusted at sign-in
  // time instead.
  emailVerified DateTime? @map("email_verified")
  // bcrypt hash, for the Credentials (email/password) provider. Null for Google-only accounts —
  // rejected explicitly in auth.ts's authorize(), not treated as "no password required."
  password      String?
  // Required literal field name for @auth/prisma-adapter's internal OAuth-account bookkeeping —
  // deliberately NOT the same field as avatarUrl below (the app's own display avatar) to avoid
  // conflating "OAuth plumbing" with "what the UI shows."
  image         String?   @map("oauth_image")
  accounts      Account[]

  // Google Docs export (Doc export feature): googleRefreshToken is a bearer credential — same
  // leak-prevention rule as calendarToken, kept out of publicUserSelect. googleEmail is
  // display-only ("Connected as ..."), not sensitive, so it stays IN publicUserSelect like phone.
  // Unrelated to the Account model above — that's login-with-Google; this is the separate
  // "connect your Google account to export Docs" flow. Two independent Google integrations.
  googleRefreshToken String? @map("google_refresh_token")
  googleEmail        String? @map("google_email")
  // Personal profile ("Me" zone) — avatarUrl is a plain URL string, same "no upload, just a
  // URL" precedent as Space.coverImageUrl (this app has no file/blob storage).
  avatarUrl     String?   @map("avatar_url")
  bio           String?
  linkedinUrl   String?   @map("linkedin_url")
  websiteUrl    String?   @map("website_url")
  roomId        String?   @map("room_id")
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  tasks         Task[]    @relation("TaskAssignees")
  events        Event[]   @relation("EventAssignees")
  workspaceMemberships WorkspaceMembership[]
  roles         Role[]    @relation("RoleMembers")
  invitesCreated WorkspaceInvite[]
  connectionsAsA    Connection[]      @relation("ConnectionsAsA")
  connectionsAsB    Connection[]      @relation("ConnectionsAsB")
  connectionInvite  ConnectionInvite? @relation("ConnectionInviteCreator")
  connectionRequestsSent     ConnectionRequest[] @relation("ConnectionRequestsSent")
  connectionRequestsReceived ConnectionRequest[] @relation("ConnectionRequestsReceived")
  comments      Comment[]
  ownedDocs     Doc[]     @relation("DocOwner")
  docComments   DocComment[]
  createdChatChannels   ChatChannel[]       @relation("ChatChannelCreator")
  chatChannelMemberships ChatChannelMember[]
  chatMessages  ChatMessage[]
  chatReactions ChatReaction[]
  createdAt     DateTime  @default(now()) @map("created_at")
}

// Standard @auth/prisma-adapter model, needed only for Google OAuth account linking — sessions
// are JWT-only (Credentials + Auth.js can't use database sessions), so no Session model exists
// here, and no Email/magic-link provider exists, so no VerificationToken model either.
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// 8. Selve oppgaven & Subtasks
model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  status      String
  priority    Int?

  startDate DateTime? @map("start_date")
  dueDate   DateTime? @map("due_date")
  // Planner/Calendar lane index, manually chosen by dragging a task's bar vertically — null means
  // "let assignLanes (lib/ganttLayout.ts) auto-pack it," a number pins it to that exact lane
  // regardless of what the greedy packer would otherwise choose. A single global value, not
  // per-week-row, so a task spanning multiple weeks renders at the same lane in every row it
  // appears in.
  calendarLane Int? @map("calendar_lane")

  archived   Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  listId String @map("list_id")
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  parentId String? @map("parent_id")
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  assignees User[]    @relation("TaskAssignees")
  comments  Comment[]
  docs      Doc[]
  chatChannels ChatChannel[]

  customFieldValues String @default("{}") @map("custom_field_values")

  // See Space.isPrivate/accessJson above — same shape, independent at this level.
  isPrivate  Boolean @default(false) @map("is_private")
  accessJson String  @default("[]") @map("access_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// Planner "Event" — happens on a given day, clickable for details like Google Calendar, but
// deliberately never creates a Task row (no required Space/Folder/List, unlike Task.listId which
// is required). Kept as its own clean standalone model rather than a Task variant specifically so
// a future real Google Calendar sync (flagged by the user as wanted eventually, not built here)
// has a natural, un-overloaded table to sync against — any sync-specific fields get added
// additively then, nothing speculative is reserved here now.
model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  allDay      Boolean   @default(true) @map("all_day")
  // Used only when spaceId is null — an Event linked to a Space instead cascades that Space's own
  // color, same precedent CalendarView.tsx's taskColorOf already uses for Task bars.
  color       String?
  spaceId     String?   @map("space_id")
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignees   User[]    @relation("EventAssignees")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
}

// 9. Kommentarer OG aktivitetslogg på en task (skilt med "type")
model Comment {
  id           String  @id @default(uuid())
  body         String
  type         String  @default("comment") // 'comment' | 'activity'
  activityKind String? @map("activity_kind") // icon selector for type='activity' rows — see ACTIVITY_ICONS in app/page.tsx

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
}

// 10. Navngitte dokumenter — enten under en task (autolagring i task-modalen), eller løsrevet i en
// Space/DocFolder-struktur (den nye "Docs"-fanen). taskId/spaceId+folderId er uavhengige av
// hverandre — et dokument kan i prinsippet være begge deler, selv om ingen UI setter det opp ennå.
model Doc {
  id        String    @id @default(uuid())
  title     String    @default("Untitled")
  content   String    @default("")
  color     String?
  // Independent from `color` above — colors the sidebar/name text specifically, icon stays on
  // `color` alone. Null falls back to `color`.
  textColor String?   @map("text_color")
  ydoc      Bytes?
  order     Int       @default(0)
  deletedAt DateTime? @map("deleted_at")
  // Non-destructive, independent of deletedAt (Trash) — see List.archived's comment, same idea.
  // Cascades to every subpage in this doc's own subtree on archive/restore.
  archived  Boolean   @default(false)

  // Page-level presentation settings (ClickUp's "Page Styles" panel, DocFormatPanel.tsx) — every
  // one of these only affects the standalone Docs/Tasks-tab doc header, never the lightweight
  // embedded editor in a task modal's Documents panel. coverImageUrl/subtitle are presence-based
  // (null = not shown), same "no upload, just a URL" precedent as Space.coverImageUrl and no
  // separate on/off flag needed, same reasoning. showLastModified needs a real boolean since a
  // timestamp always exists — there's no natural "unset" state to hide behind.
  coverImageUrl    String?  @map("cover_image_url")
  subtitle         String?
  pageWidth        String   @default("normal") @map("page_width") // 'normal' | 'full'
  showLastModified Boolean  @default(true) @map("show_last_modified")

  taskId String? @map("task_id")
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  spaceId String? @map("space_id")
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  folderId String?    @map("doc_folder_id")
  folder   DocFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // A second, independent folder axis — which real `Folder` (the same one that holds Lists) this
  // Doc sits under in the Tasks-tab sidebar, completely separate from folderId/DocFolder above
  // (the Docs tab's own tree). A Doc can be in both at once, either, or neither — same "task-scoped
  // AND/OR Space-scoped" independence this model already has. Named after this app's own internal
  // name for the Tasks tab (`activeView: 'board' | ...'`), not `taskFolderId`, which would read
  // confusingly next to the unrelated `taskId` field above.
  boardFolderId String? @map("board_folder_id")
  boardFolder   Folder? @relation(fields: [boardFolderId], references: [id], onDelete: Cascade)

  // Subpages — a Doc nested under another Doc (independent of the folderId/DocFolder tree above).
  // A child doc's own folderId is left null; it's reached only through its parent's Subpages table
  // or the sidebar's own expand-in-place, never the flat folder listing (see PLANNING.md).
  parentId String? @map("parent_doc_id")
  parent   Doc?    @relation("DocChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Doc[]   @relation("DocChildren")

  // Set once at creation to whoever created the doc; never auto-changes afterward.
  ownerId String? @map("owner_id")
  owner   User?   @relation("DocOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // JSON-encoded array of userIds who have connected to edit this doc (see collabServer.ts's
  // onAuthenticate) — same JSON-in-String convention as accessJson elsewhere in this schema.
  contributorIdsJson String @default("[]") @map("contributor_ids_json")

  docComments DocComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// Selection-anchored comments on a Doc's own content — separate from Comment (Task-only, no
// anchor/range concept, no reply-threading) rather than overloading it. markId is shared by every
// comment in one thread and is also stored as the Tiptap `comment` mark's own attribute in the
// live doc content (lib/collab/commentMark.ts) — that's what links highlighted text back to its
// thread. parentId self-relation gives one level of replies (thread root = parentId: null).
model DocComment {
  id     String @id @default(uuid())
  body   String
  docId  String @map("doc_id")
  doc    Doc    @relation(fields: [docId], references: [id], onDelete: Cascade)
  markId String @map("mark_id")

  parentId String?      @map("parent_id")
  parent   DocComment?  @relation("DocCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DocComment[] @relation("DocCommentReplies")

  // Only meaningful on the thread root — a snapshot of the commented text at creation time, so
  // the panel can still show what was commented on even after resolving removes the live
  // highlight, or the text itself gets edited away entirely.
  quotedText String?  @map("quoted_text")
  resolved   Boolean  @default(false)

  authorId String? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
}

// 11. Mappe-struktur for løsrevne (ikke task-bundne) Docs — speiler Folder (Space > Folder > List)
model DocFolder {
  id        String      @id @default(uuid())
  name      String
  color     String?
  icon      String?
  deletedAt DateTime?   @map("deleted_at")
  spaceId   String      @map("space_id")
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId  String?     @map("parent_id")
  parent    DocFolder?  @relation("DocFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocFolder[] @relation("DocFolderChildren")
  docs      Doc[]
  order     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at")
}

// 12. Chat — channels/DMs (Prisma-native content, Hocuspocus is only ever a live-signal transport
// for this, see PLANNING.md's "Planned: Discord/Slack-style chat" section). Phase 1: schema only,
// built once for every later phase so none of them need their own migration.
model ChatChannel {
  id          String     @id @default(uuid())
  // Nullable — only 'channel' rows are truly workspace-scoped. 'dm'/'group_dm' rows are created
  // with workspaceId: null (a DM can span people who share no workspace at all, or several).
  // SetNull (not Cascade) mirrors this same model's own taskId/spaceId precedent below — deleting
  // a Workspace must never destroy a real channel's message history just because it happened to
  // be created there.
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  type  String  // 'channel' | 'dm' | 'group_dm'
  name  String?
  topic String?

  // Loosely-related, optional link — never required, unlike Doc.taskId. SetNull (not Cascade like
  // Doc.taskId/spaceId) so a channel's message history isn't destroyed just because the Task/Space
  // it was tied to got deleted, same reasoning as Event.spaceId/User.roomId.
  taskId String? @map("task_id")
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  spaceId String? @map("space_id")
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Reused verbatim from Space/Folder/List/Task (see lib/auth/access.ts) — only meaningful for
  // type='channel'. DM/group-DM visibility goes through ChatChannelMember membership directly and
  // must never be checked via canSee — its "owner/admin always sees everything" rule would
  // incorrectly let a workspace owner see into two other members' private DM.
  isPrivate  Boolean @default(false) @map("is_private")
  accessJson String  @default("[]") @map("access_json")

  // 1:1-DM dedupe key — `[userIdA, userIdB].sort().join(':')`, workspace-independent (previously
  // embedded workspaceId; a pair who share more than one Workspace, or who connect outside any
  // Workspace, must still land on exactly one conversation). Null for channel/group_dm rows, since
  // group DMs deliberately don't dedupe (every "create group" makes a new row, matching real
  // Slack/Discord).
  dmKey String? @unique @map("dm_key")

  // Denormalized "most recent activity" timestamp, defaulted to createdAt's own value so a
  // brand-new empty DM still sorts sensibly before its first message. Bumped in the same request
  // that creates a top-level message or a thread reply — the cheap alternative to a correlated
  // MAX(ChatMessage.createdAt) subquery on every DM-list fetch.
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ChatChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members  ChatChannelMember[]
  messages ChatMessage[]

  // Channel is a container object like Space/List/Folder/Doc, so it gets the normal Trash pattern
  // even though individual messages deliberately don't (hard delete, decided for v1). No
  // delete/restore route touches this yet — deliberately unbuilt in Phase 1.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
}

model ChatChannelMember {
  id        String      @id @default(uuid())
  channelId String      @map("channel_id")
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unused until the optional Phase 8 unread-tracking work — included now so that phase doesn't
  // need its own migration touching this row again.
  lastReadMessageId String?   @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([channelId, userId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  channelId String      @map("channel_id")
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // SetNull — same "history outlives the person" precedent as Comment.authorId/DocComment.authorId.
  authorId String? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body String

  // Inline quote-reply (orthogonal to threading below — a message can be both at once). Snapshots
  // are captured at reply-creation time, same idea as DocComment.quotedText, so the quote preview
  // keeps showing what was actually quoted even after the original is edited/hard-deleted.
  quotedMessageId    String?       @map("quoted_message_id")
  quotedMessage      ChatMessage?  @relation("ChatMessageQuotes", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy           ChatMessage[] @relation("ChatMessageQuotes")
  quotedBodySnapshot String?       @map("quoted_body_snapshot")
  quotedAuthorId     String?       @map("quoted_author_id")

  // Thread branch (orthogonal to quoting above). SetNull, not Cascade — deleting a root shouldn't
  // cascade-destroy every reply; former replies just fall back to rendering as normal main-feed
  // messages once threadRootId goes null. threadReplyCount is denormalized, kept in sync in the
  // same request that creates/deletes a thread reply, to avoid a COUNT(*) per rendered message.
  threadRootId     String?       @map("thread_root_id")
  threadRoot       ChatMessage?  @relation("ChatMessageThread", fields: [threadRootId], references: [id], onDelete: SetNull)
  threadReplies    ChatMessage[] @relation("ChatMessageThread")
  threadReplyCount Int           @default(0) @map("thread_reply_count")

  reactions   ChatReaction[]
  attachments ChatAttachment[]

  createdAt DateTime @default(now()) @map("created_at")
}

model ChatReaction {
  id        String      @id @default(uuid())
  messageId String      @map("message_id")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([messageId, userId, emoji])
}

model ChatAttachment {
  id        String      @id @default(uuid())
  messageId String      @map("message_id")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url      String
  kind     String  @default("image")
  fileName String? @map("file_name")
  byteSize Int?    @map("byte_size")
  width    Int?
  height   Int?

  createdAt DateTime @default(now()) @map("created_at")
}
