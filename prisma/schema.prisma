datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Øverste beholder
model Workspace {
  id              String   @id @default(uuid())
  name            String
  messageOfTheDay String?  @map("message_of_the_day")
  spaces          Space[]
  rooms           Room[]
  // Explicit join model, not a plain implicit M2M like Task.assignees/User.tasks below — this one
  // needs to carry a role tier (owner/admin/member) per membership row, which an implicit M2M
  // can't do. A workspace with exactly one member is still what "private" means in this app:
  // nobody else is ever a member, so nothing scoped under it is ever returned to anyone else's
  // GET /api/tasks etc.
  memberships     WorkspaceMembership[]
  roles           Role[]
  invites         WorkspaceInvite[]
  // The one auto-created single-member workspace behind the sidebar's private "My tasks" list —
  // distinguishes it from any other single-member workspace a user creates by hand via the
  // normal switcher (which should still show up there; this one deliberately doesn't).
  isPersonal      Boolean  @default(false) @map("is_personal")
  // Unique per user — makes find-or-create atomic via a single upsert (POST
  // /api/workspaces/personal) instead of a separate findFirst-then-create, which raced under
  // React Strict Mode's dev-mode double-invoke (two near-simultaneous requests both saw "no
  // existing personal workspace" and both created one). Null for every non-personal workspace.
  personalOwnerId String?  @unique @map("personal_owner_id")
  createdAt       DateTime @default(now()) @map("created_at")
}

// Workspace membership + role tier (owner/admin/member) — governs who can manage the workspace
// itself: create/delete Roles, mark Spaces/Folders/Lists/Tasks private, manage other members'
// Admin status. Exactly one 'owner' row per workspace (the creator; enforced at the application
// layer, not the schema — SQLite/Prisma has no partial-unique-index support to express "at most
// one row per workspaceId where role='owner'"). Distinct from Role below: this tier is a fixed,
// three-value governance concept, not an arbitrary user-created access-grouping tag.
model WorkspaceMembership {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // 'owner' | 'admin' | 'member'
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, userId])
}

// Arbitrary, workspace-scoped, user-named groups (Discord-style) — used purely for granting
// access to private Spaces/Folders/Lists/Tasks (see their accessJson below), not permission bits.
// A user's Role membership only matters within that Role's own workspace.
model Role {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String    @default("#6366F1")
  members     User[]    @relation("RoleMembers")
  createdAt   DateTime  @default(now()) @map("created_at")
}

// Shareable, Discord-style invite link (the `id` itself is the code in /invite/[id]) — reusable
// and unlimited by default (no expiry/max-uses in this pass, matching Discord's own default
// invite behavior; not asked for, a deliberate scope cut rather than a silent gap). "Revoking" an
// invite is just deleting this row — GET/accept both treat a missing row as an invalid link, so
// no separate `revoked` flag is needed. Never carries role: 'owner' — that tier is fixed at
// workspace creation with no transfer mechanism.
model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("member") // 'admin' | 'member'
  createdById String    @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
}

// Kosé "kontorer" i Office-fanen — rent visuelt/organisatorisk, ingen kobling til Space-treet.
// Sletting av et rom fjerner ikke medlemmene, de blir bare urepresenterte (SetNull).
model Room {
  id          String    @id @default(uuid())
  name        String
  icon        String?
  color       String?
  order       Int       @default(0)
  isDnd       Boolean   @default(false) @map("is_dnd")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     User[]
  createdAt   DateTime  @default(now()) @map("created_at")
}

// 2. Avdelinger
model Space {
  id            String        @id @default(uuid())
  name          String
  color         String        @default("#3B82F6")
  // Same nullable lucide-icon-name shape as Folder.icon/List.icon below (FOLDER_ICON_MAP in
  // components/FolderTree.tsx maps the string to a component) — null means "no icon chosen yet,"
  // rendered as today's plain color dot instead. Personalizing a Space before this was just typing
  // an emoji into its name; this is the real, dedicated field.
  icon          String?
  order         Int           @default(0)
  description   String?
  coverImageUrl String?       @map("cover_image_url")
  deletedAt     DateTime?     @map("deleted_at")
  workspaceId   String        @map("workspace_id")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folders       Folder[]
  lists         List[]
  statuses      Status[]
  customFields  CustomField[]
  docFolders    DocFolder[]
  docs          Doc[]
  // Independent per-level private access (Space/Folder/List/Task each have this same pair) — a
  // private item is visible only to the workspace's Owner/Admins plus whoever accessJson grants.
  // Defaults keep every existing row (and every new one until someone opts in) fully open, same
  // as today — purely additive. JSON array of { type: 'user' | 'role', id: string }, same
  // "small flexible list as a JSON string" shape as CustomField.options below — a stale
  // user/role id left behind after a deletion is harmless here for the same reason @mentions
  // already tolerate dangling targets (falls back to "not visible to anyone but Owner/Admin,"
  // never a crash).
  isPrivate     Boolean       @default(false) @map("is_private")
  accessJson    String        @default("[]") @map("access_json")
  createdAt     DateTime      @default(now()) @map("created_at")
}

// 3. Valgfritt mellomnivå (Mappe) — kan nøstes vilkårlig dypt i seg selv
model Folder {
  id         String    @id @default(uuid())
  name       String
  color      String?
  icon       String?
  deletedAt  DateTime? @map("deleted_at")
  spaceId    String    @map("space_id")
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId   String?   @map("parent_id")
  parent     Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]  @relation("FolderChildren")
  lists      List[]
  docs       Doc[]
  order      Int       @default(0)
  // See Space.isPrivate/accessJson above — same shape, independent at this level.
  isPrivate  Boolean   @default(false) @map("is_private")
  accessJson String    @default("[]") @map("access_json")
  createdAt  DateTime  @default(now()) @map("created_at")
}

// 4. Endestasjon for oppgaver (Lister)
model List {
  id         String    @id @default(uuid())
  name       String
  color      String?
  icon       String?
  deletedAt  DateTime? @map("deleted_at")
  spaceId    String    @map("space_id")
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folderId   String?   @map("folder_id")
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  order      Int       @default(0)
  tasks      Task[]
  // See Space.isPrivate/accessJson above — same shape, independent at this level.
  isPrivate  Boolean   @default(false) @map("is_private")
  accessJson String    @default("[]") @map("access_json")
  createdAt  DateTime  @default(now()) @map("created_at")
}

// 5. Egendefinerte statuser per Space
model Status {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#94A3B8")
  order     Int      @default(0)
  spaceId   String   @map("space_id")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
}

// 6. Egendefinerte felt/kolonner per Space
model CustomField {
  id        String   @id @default(uuid())
  name      String
  type      String
  options   String   @default("[]")
  spaceId   String   @map("space_id")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
}

// 7. Brukere som kan tildeles oppgaver / skrive kommentarer
model User {
  id            String    @id @default(uuid())
  name          String
  // Defaulted (was bare-required) — @auth/prisma-adapter's createUser() only ever supplies
  // id/name/email/emailVerified/image, so a brand-new Google sign-in's very first insert would
  // otherwise violate NOT NULL before anything else runs. Backfilled to a real value right after,
  // in auth.ts's events.createUser hook.
  initials      String    @default("")
  color         String    @default("#6366F1")
  calendarToken String    @unique @default(uuid()) @map("calendar_token")
  phone         String?
  title         String?
  status        String?
  isDnd         Boolean   @default(false) @map("is_dnd")

  // Real accounts (Google OAuth + email/password login). Nullable+unique mirrors the existing
  // Workspace.personalOwnerId precedent — SQLite treats NULL as distinct under a unique index, so
  // every seeded/demo User keeps email: null with zero collisions, while every real signup gets a
  // genuinely unique one. Seed users are permanently unreachable via real login (no email, no
  // password, no linked Account) — real accounts start completely fresh, seed data stays only as
  // local dev/demo fixture data.
  email         String?   @unique
  // Required by @auth/prisma-adapter's AdapterUser contract (written on OAuth sign-in). No
  // magic-link/verification-email flow exists — Google's asserted email is trusted at sign-in
  // time instead.
  emailVerified DateTime? @map("email_verified")
  // bcrypt hash, for the Credentials (email/password) provider. Null for Google-only accounts —
  // rejected explicitly in auth.ts's authorize(), not treated as "no password required."
  password      String?
  // Required literal field name for @auth/prisma-adapter's internal OAuth-account bookkeeping —
  // deliberately NOT the same field as avatarUrl below (the app's own display avatar) to avoid
  // conflating "OAuth plumbing" with "what the UI shows."
  image         String?   @map("oauth_image")
  accounts      Account[]

  // Google Docs export (Doc export feature): googleRefreshToken is a bearer credential — same
  // leak-prevention rule as calendarToken, kept out of publicUserSelect. googleEmail is
  // display-only ("Connected as ..."), not sensitive, so it stays IN publicUserSelect like phone.
  // Unrelated to the Account model above — that's login-with-Google; this is the separate
  // "connect your Google account to export Docs" flow. Two independent Google integrations.
  googleRefreshToken String? @map("google_refresh_token")
  googleEmail        String? @map("google_email")
  // Personal profile ("Me" zone) — avatarUrl is a plain URL string, same "no upload, just a
  // URL" precedent as Space.coverImageUrl (this app has no file/blob storage).
  avatarUrl     String?   @map("avatar_url")
  bio           String?
  linkedinUrl   String?   @map("linkedin_url")
  websiteUrl    String?   @map("website_url")
  roomId        String?   @map("room_id")
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  tasks         Task[]    @relation("TaskAssignees")
  workspaceMemberships WorkspaceMembership[]
  roles         Role[]    @relation("RoleMembers")
  invitesCreated WorkspaceInvite[]
  comments      Comment[]
  ownedDocs     Doc[]     @relation("DocOwner")
  docComments   DocComment[]
  createdAt     DateTime  @default(now()) @map("created_at")
}

// Standard @auth/prisma-adapter model, needed only for Google OAuth account linking — sessions
// are JWT-only (Credentials + Auth.js can't use database sessions), so no Session model exists
// here, and no Email/magic-link provider exists, so no VerificationToken model either.
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// 8. Selve oppgaven & Subtasks
model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  status      String
  priority    Int?

  startDate DateTime? @map("start_date")
  dueDate   DateTime? @map("due_date")
  // Planner/Calendar lane index, manually chosen by dragging a task's bar vertically — null means
  // "let assignLanes (lib/ganttLayout.ts) auto-pack it," a number pins it to that exact lane
  // regardless of what the greedy packer would otherwise choose. A single global value, not
  // per-week-row, so a task spanning multiple weeks renders at the same lane in every row it
  // appears in.
  calendarLane Int? @map("calendar_lane")

  archived   Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  listId String @map("list_id")
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  parentId String? @map("parent_id")
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  assignees User[]    @relation("TaskAssignees")
  comments  Comment[]
  docs      Doc[]

  customFieldValues String @default("{}") @map("custom_field_values")

  // See Space.isPrivate/accessJson above — same shape, independent at this level.
  isPrivate  Boolean @default(false) @map("is_private")
  accessJson String  @default("[]") @map("access_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// 9. Kommentarer OG aktivitetslogg på en task (skilt med "type")
model Comment {
  id           String  @id @default(uuid())
  body         String
  type         String  @default("comment") // 'comment' | 'activity'
  activityKind String? @map("activity_kind") // icon selector for type='activity' rows — see ACTIVITY_ICONS in app/page.tsx

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
}

// 10. Navngitte dokumenter — enten under en task (autolagring i task-modalen), eller løsrevet i en
// Space/DocFolder-struktur (den nye "Docs"-fanen). taskId/spaceId+folderId er uavhengige av
// hverandre — et dokument kan i prinsippet være begge deler, selv om ingen UI setter det opp ennå.
model Doc {
  id        String    @id @default(uuid())
  title     String    @default("Untitled")
  content   String    @default("")
  color     String?
  ydoc      Bytes?
  order     Int       @default(0)
  deletedAt DateTime? @map("deleted_at")

  taskId String? @map("task_id")
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  spaceId String? @map("space_id")
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  folderId String?    @map("doc_folder_id")
  folder   DocFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // A second, independent folder axis — which real `Folder` (the same one that holds Lists) this
  // Doc sits under in the Tasks-tab sidebar, completely separate from folderId/DocFolder above
  // (the Docs tab's own tree). A Doc can be in both at once, either, or neither — same "task-scoped
  // AND/OR Space-scoped" independence this model already has. Named after this app's own internal
  // name for the Tasks tab (`activeView: 'board' | ...'`), not `taskFolderId`, which would read
  // confusingly next to the unrelated `taskId` field above.
  boardFolderId String? @map("board_folder_id")
  boardFolder   Folder? @relation(fields: [boardFolderId], references: [id], onDelete: Cascade)

  // Subpages — a Doc nested under another Doc (independent of the folderId/DocFolder tree above).
  // A child doc's own folderId is left null; it's reached only through its parent's Subpages table
  // or the sidebar's own expand-in-place, never the flat folder listing (see PLANNING.md).
  parentId String? @map("parent_doc_id")
  parent   Doc?    @relation("DocChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Doc[]   @relation("DocChildren")

  // Set once at creation to whoever created the doc; never auto-changes afterward.
  ownerId String? @map("owner_id")
  owner   User?   @relation("DocOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // JSON-encoded array of userIds who have connected to edit this doc (see collabServer.ts's
  // onAuthenticate) — same JSON-in-String convention as accessJson elsewhere in this schema.
  contributorIdsJson String @default("[]") @map("contributor_ids_json")

  docComments DocComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// Selection-anchored comments on a Doc's own content — separate from Comment (Task-only, no
// anchor/range concept, no reply-threading) rather than overloading it. markId is shared by every
// comment in one thread and is also stored as the Tiptap `comment` mark's own attribute in the
// live doc content (lib/collab/commentMark.ts) — that's what links highlighted text back to its
// thread. parentId self-relation gives one level of replies (thread root = parentId: null).
model DocComment {
  id     String @id @default(uuid())
  body   String
  docId  String @map("doc_id")
  doc    Doc    @relation(fields: [docId], references: [id], onDelete: Cascade)
  markId String @map("mark_id")

  parentId String?      @map("parent_id")
  parent   DocComment?  @relation("DocCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DocComment[] @relation("DocCommentReplies")

  // Only meaningful on the thread root — a snapshot of the commented text at creation time, so
  // the panel can still show what was commented on even after resolving removes the live
  // highlight, or the text itself gets edited away entirely.
  quotedText String?  @map("quoted_text")
  resolved   Boolean  @default(false)

  authorId String? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
}

// 11. Mappe-struktur for løsrevne (ikke task-bundne) Docs — speiler Folder (Space > Folder > List)
model DocFolder {
  id        String      @id @default(uuid())
  name      String
  color     String?
  icon      String?
  deletedAt DateTime?   @map("deleted_at")
  spaceId   String      @map("space_id")
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId  String?     @map("parent_id")
  parent    DocFolder?  @relation("DocFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocFolder[] @relation("DocFolderChildren")
  docs      Doc[]
  order     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at")
}
