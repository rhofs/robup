{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Capacitor's own config, read by the `cap` CLI and never by the app. It imports types from
    // @capacitor/cli, which is a devDependency — so type-checking it during `next build` makes the
    // production build depend on a dev-only package being present. Excluded so the app's build can
    // never fail over a file the app does not use. `npx cap` loads it with its own loader and is
    // unaffected.
    "capacitor.config.ts",
    // Generated native project: Java and Gradle, nothing for TypeScript to check, and no reason to
    // walk hundreds of files on every build.
    "android"
  ]
}
